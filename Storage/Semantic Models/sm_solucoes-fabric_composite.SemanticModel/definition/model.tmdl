model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["TMDLView_Desktop", "RemoteModeling", "SLL", "WebModelingEdit", "DirectLakeOnOneLakeInWeb", "SLL_UpdateDLConnection_DLOL"]

annotation PBI_QueryOrder = ["DirectLake - lh_gold","DimDate","server","Database"]

annotation __PBI_TimeIntelligenceEnabled = 1

ref table FactSales
ref table DimCustomers
ref table DimProducts
ref table DimDate

